# ─── Service identity ────────────────────────────────────────────────────────
# Required, fail-closed: there is no default. Missing, empty or unrecognized
# values make Settings construction fail rather than silently defaulting to
# development. Accepted (case-insensitive, surrounding whitespace ignored):
#   production | prod            → production   (full production policy)
#   staging | stage | preprod |
#   pre-production               → staging      (full production policy)
#   development | dev | local    → development  (relaxed, local use)
#   test | tests                 → test         (relaxed, automated tests)
# "staging" enforces every production requirement, so staging cannot drift
# away from the checks production relies on.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API authentication ───────────────────────────────────────────────────────
# Required in production. Bearer token callers must supply.
API_AUTH_TOKEN=

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (development): sqlite+aiosqlite:///./secure_downloads.db
# PostgreSQL (production): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./secure_downloads.db

# ─── Egress proxy ────────────────────────────────────────────────────────────
# All outbound download connections MUST route through this proxy.
#
# Production (ENVIRONMENT=production) is fail-closed: startup is refused unless
#   EGRESS_PROXY_URL and EGRESS_PROXY_HEALTH_URL are both non-empty and
#   REQUIRE_EGRESS_PROXY=true.
# There is no supported way to run a production download without a proxy.
EGRESS_PROXY_URL=http://127.0.0.1:3128
# The health endpoint must answer HTTP 200 with JSON
#   {"status": "ok", "mode": "enforcing"}
# Anything else — unreachable, non-200, non-JSON, a status other than "ok",
# or a "mode" that is absent or not "enforcing" — blocks the download.
# This is the proxy's own attestation of its mode. It does not detect a proxy
# that lies about itself; the proxy remains the only authority on where its
# connections actually terminate.
EGRESS_PROXY_HEALTH_URL=http://127.0.0.1:9090/health/ready
REQUIRE_EGRESS_PROXY=true
# Optional Basic-auth password for the egress proxy.
#
# This is a real credential, not a placeholder: when set, the downloader sends
#   Proxy-Authorization: Basic base64("agentshield:<PROXY_AUTH_TOKEN>")
# on every proxied request (the username is fixed; only the password comes from
# this value). The token is percent-encoded into the proxy URL's userinfo, is
# never written to logs, and never appears in error messages or health output.
# Setting PROXY_AUTH_TOKEN without EGRESS_PROXY_URL is rejected at startup.
# Leave empty if your proxy performs no client authentication.
PROXY_AUTH_TOKEN=

# ─── Domain / port policy ────────────────────────────────────────────────────
# Must match the values set on the egress proxy and browser worker.
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
DEFAULT_DOMAIN_POLICY=deny
ALLOWED_PORTS=80,443

# ─── SSRF / network hardening ────────────────────────────────────────────────
# Production refuses ALLOW_PRIVATE_NETWORKS=true and DNS_PREFLIGHT_ENABLED=false.
ALLOW_PRIVATE_NETWORKS=false
# Re-resolves the hostname in the transport chain before each request and
# blocks if any answer is a disallowed address. This is a gate check on a
# *second lookup*, NOT DNS pinning: the validated address is not the address
# the socket connects to, so a rebinding window remains. See README
# "Connection security model" for the accurate boundary.
DNS_PREFLIGHT_ENABLED=true

# ─── Download limits ─────────────────────────────────────────────────────────
# Maximum file size in bytes (default 50 MB)
MAX_FILE_SIZE_BYTES=52428800
# Connection timeout in seconds
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10.0
# Per-read timeout in seconds
DOWNLOAD_READ_TIMEOUT_SECONDS=30.0
# Total deadline for one download in seconds
DOWNLOAD_TOTAL_TIMEOUT_SECONDS=120.0
# Maximum number of HTTP redirects to follow
MAX_REDIRECTS=5
# Maximum concurrent downloads per tenant
MAX_CONCURRENT_DOWNLOADS_PER_TENANT=5

# ─── ClamAV ──────────────────────────────────────────────────────────────────
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60.0
# Fail closed: if true, treat scanner unavailability as QUARANTINED
CLAMAV_FAIL_CLOSED=true

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_ROOT=/var/secure-download-storage
# How long approved files are retained before expiry (seconds, default 1 hour)
APPROVED_FILE_TTL_SECONDS=3600
# Quarantined files are deliberately retained; their deletion is an
# operator/forensics policy decision, not an automatic timer.

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# ─── Document analysis provider ──────────────────────────────────────────────
# Selects the document-analysis adapter:
#   disabled    — analysis endpoints return 409 ANALYSIS_DISABLED (downloads work)
#   local_mock  — in-process fake, for local testing ONLY (refused in production)
#   http        — real provider adapter; the only mode accepted in production
# Production (and staging) refuses "disabled" and "local_mock", requires an
# https endpoint and an API token, and refuses the two test escape hatches.
ANALYSIS_PROVIDER=disabled

# Real provider integration. Contract v1: a synchronous POST of the approved
# document bytes with metadata; the provider returns the normalized JSON
# result documented in README "Document analysis provider contract".
ANALYSIS_ENDPOINT_URL=
# Bearer credential sent as Authorization: Bearer <token>. Never logged and
# never included in error messages.
ANALYSIS_API_TOKEN=

# Bounded per-request timeouts (seconds) and retry policy.
ANALYSIS_CONNECT_TIMEOUT_SECONDS=5.0
ANALYSIS_READ_TIMEOUT_SECONDS=30.0
ANALYSIS_TOTAL_TIMEOUT_SECONDS=60.0
# Wall-clock ceiling for one analysis job including retries.
ANALYSIS_JOB_TIMEOUT_SECONDS=120.0
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_RETRY_BASE_DELAY_SECONDS=0.25
# Fixed worker pool size; the runner never spawns unbounded tasks.
ANALYSIS_WORKER_CONCURRENCY=2

# Hard caps on the provider boundary (bytes).
ANALYSIS_MAX_PAYLOAD_BYTES=10485760
ANALYSIS_MAX_RESPONSE_BYTES=2097152

# Hard caps on local PDF processing. Bounds page count, extracted text and
# per-document CPU time; a document exceeding any of them fails that analysis.
ANALYSIS_MAX_PAGES=200
ANALYSIS_MAX_EXTRACTED_CHARS=200000
ANALYSIS_PROCESSING_TIMEOUT_SECONDS=20.0

# Test-only escape hatches. Both are refused in production-like environments.
# ANALYSIS_ALLOW_INSECURE_LOCAL permits plain-HTTP endpoints (only with a
# loopback host); ANALYSIS_ALLOW_PRIVATE_ENDPOINTS permits loopback/private
# resolution targets. They exist so the real-HTTP integration tests can run
# against a local server.
ANALYSIS_ALLOW_INSECURE_LOCAL=false
ANALYSIS_ALLOW_PRIVATE_ENDPOINTS=false

# Route provider traffic through the attested egress proxy (REQUIRE in
# production). When true, the analysis transport uses the same
# EnforcingProxyTransport as downloads and re-attests proxy mode per request.
ANALYSIS_USE_EGRESS_PROXY=true
