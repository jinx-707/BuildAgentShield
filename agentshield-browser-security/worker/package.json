{
  "name": "agentshield-browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Puppeteer browser execution worker for AgentShield",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test",
    "browser:install": "puppeteer browsers install chrome"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.16.0"
  },
  "allowScripts": {
    "puppeteer@25.16.0": true
  }
}
