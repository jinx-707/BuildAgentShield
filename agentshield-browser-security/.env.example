# AgentShield Browser Security Module — Environment Configuration
#
# Copy this file to .env and adjust values as needed.
# The .env file is git-ignored and must never be committed.
#
# SECURITY: All components default to DENY. Do not set permissive defaults
# (ALLOW_PRIVATE_NETWORKS=true, DEFAULT_DOMAIN_POLICY=allow) in production.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# API / Orchestrator
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Browser worker connection
BROWSER_WORKER_URL=http://127.0.0.1:8080
BROWSER_WORKER_TIMEOUT_SECONDS=30
BROWSER_WORKER_HEALTH_TIMEOUT_SECONDS=3

# Worker authentication (leave empty to disable — NOT recommended for production)
WORKER_AUTH_TOKEN=

# API caller authentication (leave empty to disable — NOT recommended for production)
# When set, all non-health API endpoints require: Authorization: Bearer <token>
API_AUTH_TOKEN=

# Policy and inspection backends
# mock = development-only, not a security control
# egress-policy = real domain policy enforcement
# prompt-injection = real prompt injection detection
POLICY_BACKEND=mock               # mock (dev only) | egress-policy
INSPECTION_BACKEND=mock          # mock (dev only) | prompt-injection

# Domain policy (default-deny posture)
ALLOWED_DOMAINS=example.com      # comma-separated, supports *.suffix wildcards
BLOCKED_DOMAINS=                 # comma-separated, takes precedence over allow
DEFAULT_DOMAIN_POLICY=deny      # deny | allow (use deny for production)
ALLOWED_PORTS=80,443             # comma-separated, supports ranges (e.g. 80,443,8080-8090)
MAX_REDIRECTS=5                  # 0-20, enforced by worker
BLOCK_HTTPS_DOWNGRADE=true
ALLOW_PRIVATE_NETWORKS=false     # NEVER true in production
DNS_PREFLIGHT_ENABLED=true

# Database (PostgreSQL) — required for the enterprise control plane
# Durable persistence for organizations, users, agents, policies, audit events,
# and security incidents. Leave DATABASE_URL empty to use the in-memory audit
# store (development only; no multi-tenant persistence).
DATABASE_URL=postgresql+psycopg2://agentshield:agentshield-dev-password@127.0.0.1:5432/agentshield
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield-dev-password
POSTGRES_PORT=5432

# Redis — optional, used for shared rate-limit counters and real-time event
# delivery across API replicas. Required in production when running multiple
# API replicas.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Rate limiting (per client identity, fixed window)
#
# The memory backend is development/test only. Production requires Redis so
# counters are shared across API replicas and survive restarts; startup fails
# closed if RATE_LIMIT_BACKEND=memory in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory         # memory (dev/test only) | redis
RATE_LIMIT_PER_MINUTE=60          # API-wide per-identity limit
RATE_LIMIT_NAVIGATION_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=20
RATE_LIMIT_SESSION_CREATE_PER_MINUTE=10
RATE_LIMIT_ACTION_PER_MINUTE=60
RATE_LIMIT_EXTRACT_PER_MINUTE=30
RATE_LIMIT_SCREENSHOT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=false        # NEVER true in production
# Comma-separated IPs/CIDRs. X-Forwarded-For is honored only when the direct
# TCP peer is one of these trusted proxies. Empty means ignore the header.
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_TRUSTED_PROXY_MAX_HOPS=10
REDIS_URL=                        # required when RATE_LIMIT_BACKEND=redis
REDIS_TIMEOUT_SECONDS=1.0

# Web search (C1). The API contacts only the fixed provider endpoint; caller
# input is a query, never a URL. SEARCH_API_KEY is wrapped in SecretStr and is
# never logged or returned in responses.
#
# brave       = full web search; requires SEARCH_API_KEY
# duckduckgo  = limited keyless fallback (Instant Answer API, not full web
#               search); every response carries an explicit provider_notice
SEARCH_PROVIDER=brave            # brave | duckduckgo
SEARCH_API_KEY=                  # required for brave
SEARCH_TIMEOUT_MS=5000           # 500-30000
SEARCH_MAX_RESULTS=5             # 1-20, operator ceiling

# ---------------------------------------------------------------------------
# Browser Worker
# ---------------------------------------------------------------------------
WORKER_HOST=127.0.0.1
WORKER_PORT=8080

# Browser configuration
BROWSER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=         # leave empty for Puppeteer-managed Chromium
BROWSER_NAVIGATION_TIMEOUT_MS=20000
BROWSER_MAX_CONTENT_BYTES=524288  # 512KB
BROWSER_ALLOW_PRIVATE_NETWORKS=false

# Worker-side domain policy (should match API and proxy)
ALLOWED_DOMAINS=example.com
BLOCKED_DOMAINS=
DEFAULT_DOMAIN_POLICY=deny
ALLOWED_PORTS=80,443
MAX_REDIRECTS=5
BLOCK_HTTPS_DOWNGRADE=true

# Session management
#
# Lifecycle states: a context is INITIALIZING while its page is built,
# CHECKED_OUT while a request owns it, IDLE once released, and CLOSING after its
# close has been initiated. Only IDLE contexts — and CHECKED_OUT ones whose
# lease has lapsed — are ever reaped, so an in-flight request is never closed
# out from under, whatever the idle timeout says.
#
# BROWSER_SESSION_IDLE_TIMEOUT_MS
#   How long a released (IDLE) context may stay unused before it is reaped.
#   No effect on checked-out contexts. A value below a request's duration is
#   now safe, but it increases context churn: keep it >= the slowest expected
#   navigation.
# BROWSER_SESSION_CLEANUP_INTERVAL_MS
#   Sweep cadence, independent of HTTP traffic. Clamped to
#   [1000, BROWSER_SESSION_IDLE_TIMEOUT_MS]: a sweep slower than the idle
#   timeout would extend session lifetime, so it is corrected and logged at
#   startup rather than silently accepted.
# BROWSER_SESSION_MAX_LEASE_MS
#   Last-resort ceiling on a single request's hold on a context. Only a
#   stranded lease (a handler that died without releasing) is reclaimed by it.
#   Floored at max(BROWSER_NAVIGATION_TIMEOUT_MS, 60000) + 10000 ms, because
#   60000 ms is the largest timeout_ms POST /v1/navigate accepts; any lower
#   value is raised and reported. Do not raise it past your reverse proxy's
#   own request timeout, or abandoned contexts linger.
BROWSER_SESSION_IDLE_TIMEOUT_MS=300000    # 5 minutes
BROWSER_SESSION_CLEANUP_INTERVAL_MS=30000 # background expiry sweep cadence (ms)
BROWSER_SESSION_MAX_LEASE_MS=120000       # 2 minutes; never below 70000
BROWSER_SESSION_MAX_AGE_MS=900000         # absolute session lifetime (15 minutes)
BROWSER_MAX_SESSIONS=5                    # concurrent persistent sessions
BROWSER_MAX_CONCURRENT_CONTEXTS=10

# Text extraction (B1). Output is always bounded, regardless of page size.
BROWSER_MAX_EXTRACTION_TEXT_BYTES=131072  # 128KB of plain text
BROWSER_MAX_EXTRACTION_LINKS=100

# Browser actions (D1). The worker re-validates every bound even though the
# API also validates it. Typed values are never logged and are redacted from
# returned page text.
BROWSER_ACTION_TIMEOUT_MS=10000          # 1000-60000
BROWSER_ACTION_MAX_TYPE_BYTES=4000       # per type action, UTF-8 bytes
BROWSER_ACTION_MAX_SCROLL_PX=5000        # per scroll action
BROWSER_ACTION_MAX_TEXT_BYTES=8192       # page text returned with an action

# Screenshots (D2). Images are held in memory and returned as PNG; the worker
# never writes caller-visible files or exposes a filesystem path.
BROWSER_SCREENSHOT_TIMEOUT_MS=10000             # 1000-60000
BROWSER_SCREENSHOT_MAX_WIDTH=2048
BROWSER_SCREENSHOT_MAX_HEIGHT=2048
BROWSER_SCREENSHOT_MAX_FULL_PAGE_HEIGHT=12000
BROWSER_SCREENSHOT_MAX_BYTES=5242880            # 5 MiB
BROWSER_SCREENSHOT_MAX_CONCURRENT=2
BROWSER_SCREENSHOT_RATE_LIMIT_PER_MINUTE=20     # per session
BROWSER_SCREENSHOT_MAX_PER_SESSION=100          # lifetime per session

# WebRTC (hard-blocked — setting true causes launch failure)
BROWSER_ALLOW_WEBRTC=false

# Egress proxy
EGRESS_PROXY_URL=http://127.0.0.1:3128
EGRESS_PROXY_HEALTH_URL=http://127.0.0.1:9090/health/ready
EGRESS_PROXY_HEALTH_TIMEOUT_MS=3000
EGRESS_PROXY_HEALTH_CACHE_MS=5000
PROXY_AUTH_TOKEN=                # leave empty to disable proxy auth
REQUIRE_EGRESS_PROXY=true        # critical: true = fail-closed without proxy

# ---------------------------------------------------------------------------
# Egress Security Proxy
# ---------------------------------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=3128
PROXY_HEALTH_HOST=127.0.0.1
PROXY_HEALTH_PORT=9090

# Proxy domain policy (should match API and worker)
PROXY_ALLOWED_DOMAINS=example.com
PROXY_BLOCKED_DOMAINS=
PROXY_DEFAULT_DOMAIN_POLICY=deny
PROXY_ALLOWED_PORTS=80,443
PROXY_ALLOW_PRIVATE_NETWORKS=false

# Proxy timeouts
PROXY_DNS_TIMEOUT_MS=5000
PROXY_CONNECT_TIMEOUT_MS=10000

# Proxy authentication (leave empty to disable — NOT recommended for production)
# When set, worker must use the same token via PROXY_AUTH_TOKEN
# Proxy auth username is always "agentshield"
PROXY_AUTH_TOKEN=
