# ============================================================
# AgentShield Online Security Module — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./agentshield_online.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentshield_online

# Redis (optional for local dev — rate limiting degrades gracefully)
REDIS_URL=redis://localhost:6379/0

# Browser Worker (Node.js Puppeteer)
BROWSER_WORKER_URL=http://localhost:3001
BROWSER_WORKER_API_KEY=dev-browser-worker-key-change-me

# Search Provider
# Supported: "serper", "brave", "mock"
SEARCH_PROVIDER=mock
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/online/email/oauth/callback
# Path to gmail_token.json (created after first OAuth flow)
GMAIL_TOKEN_PATH=./gmail_token.json

# Microsoft Graph (Outlook)
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=
MSGRAPH_REDIRECT_URI=http://localhost:8000/online/email/outlook/callback

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
# fail_closed = deny file if scanner unavailable
CLAMAV_FAIL_CLOSED=true

# Download settings
DOWNLOAD_BASE_DIR=./downloads
QUARANTINE_BASE_DIR=./quarantine

# Payment — Razorpay TEST MODE ONLY
# WARNING: These are test credentials. Never use live credentials here.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Payment — Stripe TEST MODE ONLY
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# Payment safety
PAYMENT_MODE=test
# Enforced at runtime: if PAYMENT_MODE != "test", server refuses to start

# HashiCorp Vault (optional — leave blank to use env-based secrets)
VAULT_URL=
VAULT_TOKEN=
VAULT_MOUNT=secret

# Internal auth (local dev — replaced by Person 4 in production)
LOCAL_AUTH_ENABLED=true
LOCAL_DEV_API_KEY=dev-api-key-change-me

# MCP
MCP_CONNECTION_TIMEOUT=30
MCP_TOOL_TIMEOUT=60
